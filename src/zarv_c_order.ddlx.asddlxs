@Metadata.layer: #CUSTOMER
@Search.searchable: true
@UI: {
  headerInfo: {
    typeName: 'Order',
    typeNamePlural: 'Orders',
     imageUrl: 'OrderImageUrl',
     title: { type: #STANDARD, label: 'Order', value: 'Orderid' }
      },

   // 1. Definition of the chart visual structures
   chart: [
    {
      qualifier:   'chartQuantity',
      chartType:   #BAR,
      dimensions:  [ 'DeliveryDate' ],
      measures:    [ 'Quantity' ],
      dimensionAttributes: [{ dimension: 'DeliveryDate', role: #CATEGORY }],
      measureAttributes:   [{ measure: 'Quantity',     role: #AXIS_1 }]
    },
    {
      qualifier:   'chartAmount',
      chartType:   #BAR,
      dimensions:  [ 'DeliveryDate' ],
      measures:    [ 'Netamount', 'Grossamount' ],
      dimensionAttributes: [{ dimension: 'DeliveryDate', role: #CATEGORY }],
      measureAttributes:   [{ measure: 'Netamount',    role: #AXIS_1 },
                            { measure: 'Grossamount',  role: #AXIS_1 }]
    }
  ],

  presentationVariant: [
    {
      sortOrder: [ { by: 'DeliveryDate', direction: #ASC } ]
    }
  ]
}

annotate view ZARV_C_ORDER with
{
  /* =========================================================================
     FACETS (STRUCTURE OF THE OBJECT PAGE)
     ========================================================================= */
  @UI.facet: [
    { id: 'idHeaderGrossAmount', purpose: #HEADER, type: #DATAPOINT_REFERENCE, position: 10, targetQualifier: 'dpGrossAmount' },
    { id: 'idHeaderNetAmount',   purpose: #HEADER, type: #DATAPOINT_REFERENCE, position: 20, targetQualifier: 'dpNetAmount' },
    { id: 'idOrderId',           purpose: #HEADER, type: #DATAPOINT_REFERENCE, position: 30, targetQualifier: 'dpOrderId' },

    { id: 'idGeneralInfo',     type: #COLLECTION,           label: 'General Information', position: 10 },
    { id: 'idOrderBasicData',  type: #FIELDGROUP_REFERENCE, label: 'Basic Data',          position: 10, parentId: 'idGeneralInfo', targetQualifier: 'OrderGroup' },

    { id: 'idAdminData',       type: #COLLECTION,           label: 'Admin Data',          position: 20 },
    { id: 'idCreate',          type: #FIELDGROUP_REFERENCE, label: 'Create Info',         position: 10, parentId: 'idAdminData',   targetQualifier: 'CreateInfo' },
    { id: 'idChange',          type: #FIELDGROUP_REFERENCE, label: 'Change Info',         position: 20, parentId: 'idAdminData',   targetQualifier: 'ChangeInfo' },

     { id:       'BusinessPartnerTab',
    purpose:  #STANDARD,
    type:     #COLLECTION,
    label:    'Business Partner',
    position: 20 },

    { id:       'BPGroup',
    purpose:  #STANDARD,
    type:     #FIELDGROUP_REFERENCE,
    parentId: 'BusinessPartnerTab',
    label:    'Business Partner Information',
    targetQualifier: 'BPData',
    position: 10 }
  ]
     /* =========================================================================
        ELEMENTS DECLARATION & UI PLACEMENT
        ========================================================================= */

  @UI.hidden: true
  OrderUuid;
  @UI.hidden: true
  ProdUuid;
  @UI.hidden: true
  MrktUuid;

  @UI: { lineItem:   [{ position: 10, label: 'Order ID' }],
         fieldGroup: [{ qualifier: 'OrderGroup', position: 10, label: 'Order ID:' }] }
  @UI.dataPoint: { qualifier: 'dpOrderId', title: 'Order ID' }
  @Search.defaultSearchElement: true
  Orderid;

  @UI: { lineItem:   [{ position: 20, label: 'Quantity' }],
         fieldGroup: [{ qualifier: 'OrderGroup', position: 40, label: 'Quantity:' }] }
  Quantity;

  @UI: { lineItem:   [{ position: 30, label: 'Delivery Date' }],
         fieldGroup: [{ qualifier: 'OrderGroup', position: 30, label: 'Delivery Date:' }] }
  @Search.defaultSearchElement: true
  DeliveryDate;

  @UI: { lineItem:   [{ position: 40, label: 'Net Amount' }] }
  @UI.dataPoint: { qualifier: 'dpNetAmount', title: 'Net Amount' }
  Netamount;

  @UI: { lineItem:   [{ position: 50, label: 'Gross Amount' }] }
  @UI.dataPoint: { qualifier: 'dpGrossAmount', title: 'Cross Amount' }
  Grossamount;

  @UI: { lineItem:   [{ position: 50, label: 'Gross Amount' }] }
  Currency;

  @UI: { lineItem:   [{ position: 60, label: 'Year' }],
         fieldGroup: [{ qualifier: 'OrderGroup', position: 20, label: 'Year:' }] }
  CalendarYear;

  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZARV_I_BUSINESS_PARTNER_C', element: 'BusinessPartner' } }]
  @UI.lineItem: [{ position: 50, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'BPData', position: 10 }]
  Busspartner;

  @UI.lineItem: [{ position: 60 }]
  @UI.fieldGroup: [{ qualifier: 'BPData', position: 20 }]
  Busspartnercompany;

  @UI.lineItem: [{ position: 70 }]
  @UI.fieldGroup: [{ qualifier: 'BPData', position: 30 }]
  Busspartneremail;

  @UI.lineItem: [{ position: 80 }]
  @UI.fieldGroup: [{ qualifier: 'BPData', position: 40 }]
  Busspartnerphone;

  @UI.fieldGroup: [{ qualifier: 'CreateInfo', position: 10, label: 'Created By:' }]
  Createdby;

  @UI.fieldGroup: [{ qualifier: 'CreateInfo', position: 20, label: 'Create Time:' }]
  Creationtime;

  @UI.fieldGroup: [{ qualifier: 'ChangeInfo', position: 10, label: 'Changed By:' }]
  Changedby;

  @UI.fieldGroup: [{ qualifier: 'ChangeInfo', position: 20, label: 'Change Time:' }]
  Changetime;
}