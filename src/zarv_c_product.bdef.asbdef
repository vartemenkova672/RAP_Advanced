projection;
strict ( 2 );
use draft;

define behavior for ZARV_C_PRODUCT alias Product
{

  use association _Market { create; }

  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  field ( readonly ) Phaseid;
  use action make_copy;
  use action move_to_next_phase;
  use action GET_PGNAME_TRANSL;
}

define behavior for ZARV_C_MARKET alias Market
{

  use association _Product;
  use association _Order { create; }

  use update;
  use delete;

  side effects
  {
    field Mrktid affects field Isocode;
  }

  field ( readonly ) Status;

  use action confirmMarketByProduct;
}

define behavior for ZARV_C_ORDER alias _tOrder
{

  use association _Market;
  use association _Product;
  use update;
  use delete;

  field ( readonly ) Orderid, Currency, Netamount, Grossamount, CalendarYear;


}