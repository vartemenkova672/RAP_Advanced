managed implementation in class zarv_bp_i_product unique;
strict ( 2 );

define behavior for ZARV_I_PRODUCT alias Product
persistent table zarv_d_product
lock master
authorization master ( instance )
{
  create ( authorization : global );
  update;
  delete;

  association _Market { create; }

  field ( numbering : managed, readonly ) ProdUuid;
  field ( readonly ) Changetime, Changedby, Creationtime, Createdby;
  field ( mandatory ) Prodid, Pgid, Price, Currency;

  determination calculateProdUUID on modify { create; }
  determination setFirstPhase on modify { create; }

  validation validatePG on save { create; update; field Pgid; }
  validation validateProdID on save { create; field Prodid; }
  validation validateCurrency on save { create; update; field Currency; }

  action make_copy parameter ZARV_A_COPY_PARAM result [1] $self;
  action ( features : instance ) move_to_next_phase result [1] $self;

  mapping for zarv_d_product
    {
      ProdUuid     = prod_uuid;
      Prodid       = prodid;
      Pgid         = pgid;
      Phaseid      = phaseid;
      Height       = height;
      Depth        = depth;
      Width        = width;
      Sizeuom      = sizeuom;
      Price        = price;
      Currency     = currency;
      Taxrate      = taxrate;
      Createdby    = createdby;
      Creationtime = creationtime;
      Changedby    = changedby;
      Changetime   = changetime;
      PgnameTrans  = pgname_trans;
      TransCode    = trans_code;
    }
}

define behavior for ZARV_I_MARKET alias Market
persistent table zarv_d_market
lock dependent by _Product
authorization dependent by _Product
{
  update;
  delete;


  field ( numbering : managed, readonly ) MrktUuid;
  field ( readonly ) ProdUuid, Changetime, Changedby, Creationtime, Createdby;
  field ( mandatory ) Mrktid, Startdate;

  association _Product;

  mapping for zarv_d_market
    {
      MrktUuid     = mrkt_uuid;
      ProdUuid     = prod_uuid;
      Mrktid       = mrktid;
      Status       = status;
      Startdate    = startdate;
      Enddate      = enddate;
      Isocode      = isocode;
      Createdby    = createdby;
      Creationtime = creationtime;
      Changedby    = changedby;
      Changetime   = changetime;
    }
}